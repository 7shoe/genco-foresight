#!/usr/bin/env bash
#PBS -N genco-stage-a
#PBS -A EpiCalib
#PBS -q debug
#PBS -l select=1
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:flare
#PBS -j oe
#PBS -m n
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the repository checkout}"
# Reproduce the module versions recorded in the existing Aurora environment.
# Packages are preserved; these commands only configure runtime library paths.
set +u
if ! type module >/dev/null 2>&1; then
    source /etc/profile
fi
module --quiet reset
module load oneapi/release/2026.1.0 mpich/prd/5.0.0.aurora_test.87e2045 gcc/14.3.0
module load libfabric/2.3.1 cray-pals/1.8.0 cray-libpals/1.8.0 intel_gpu_umd_aicoe/2026.06.19
module load hdf5/1.14.6 pti-gpu/0.17.0 miniforge3/25.11.0-1 frameworks/2026.1.0
source /lus/flare/projects/FRAME-IDP/siebenschuh/envs/reason_venv_2026.1.0/bin/activate
set -u
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1
stage_a_python=/lus/flare/projects/FRAME-IDP/siebenschuh/envs/reason_venv_2026.1.0/bin/python
mpiexec --pmi=pmix --envall -n 1 --ppn 1 --cpu-bind none \
    "$stage_a_python" -u -m "${GENCO_STAGE_A_MODULE:-scripts.solver_smoke}"
